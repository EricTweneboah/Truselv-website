# Optional Node-hosted integrations. Do not put secrets in site.config.json.
PORT=4173
SITE_URL=http://localhost:4173
# Set a verified sender and Resend key to enable server-delivered enquiries.
RESEND_API_KEY=
INQUIRY_FROM="TruSelv website <website@truselv.co.uk>"
# All enquiries are delivered to support@truselv.co.uk.
IDEAL_POSTCODES_API_KEY=
# Stripe is optional. Checkout stays off until all configuration is present.
# Confirm the seller, VAT, delivery, bundle, renewal terms in site.config.json.
# Set CHECKOUT_ENABLED=true with matching test keys to test.
# Live keys also require salesReady=true after offer details are confirmed.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
# Only enable if your reverse proxy strips/replaces incoming X-Forwarded-For.
TRUST_PROXY=false
