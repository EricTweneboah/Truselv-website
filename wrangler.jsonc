{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truselv-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/js/site-config.js"]
  },
  "ratelimits": [{
    "name": "API_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 12, "period": 60 }
  }],
  "vars": {
    "CHECKOUT_ENABLED": "true",
    "INQUIRY_FROM": "TruSelv website <website@truselv.co.uk>"
  },
  "observability": { "enabled": false }
}
